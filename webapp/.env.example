# Anitalmid webapp — environment variables.
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# must NEVER be committed. This template contains names only, no secrets.
#
# The backend reads these from the process environment (Render injects them in
# production); the `.env` file is loaded as a convenience for local development,
# and real environment variables always take precedence over `.env`.

# JWT signing secret. REQUIRED in production — the app fails to start without it.
# For local development it is auto-generated and persisted to backend/.secret.
ANITALMID_SECRET=

# Postgres connection string (production). Leave empty to use local SQLite.
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:5432/anitalmid
ANITALMID_DATABASE_URL=

# Public base URL (used for links + email).
ANITALMID_BASE_URL=https://theanitalmidproject.com

# Admin metrics digest — both required for POST /admin/metrics/email to work.
ANITALMID_ADMIN_KEY=
ANITALMID_ADMIN_EMAIL=

# Email delivery (Resend HTTP API key, `re_...`).
RESEND_API_KEY=

# Email "from" address (optional; defaults to no-reply@theanitalmidproject.com).
SMTP_FROM=no-reply@theanitalmidproject.com
